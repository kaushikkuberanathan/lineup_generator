.env
.env.local
.env.smoke
.env.development
.env.production
supabase/.temp/
# Local Supabase CLI branch metadata (created by `supabase start`/`db branch`
# commands) - machine-local state, never meant to be committed.
supabase/.branches/

# Claude Code local settings
**/.claude/settings.local.json

# IDE local config
.vscode/
.idea/

# Node modules (root-level, for husky and other root devDependencies)
node_modules/

# Agent recon outputs
lint-baseline-output.txt
recon-output.txt

# npm audit snapshots (pre-fix baselines, evidence only)
**/audit-*.json

# Demo All-Stars seed (local-only raw player data, never committed)
.demo-seed/
.env*
!.env.example
spike-*.js
backend/spike-*.js
spike-*.js
backend/spike-*.js

# .claude/ is local Claude Code state by default (settings.local.json, session
# state, health-check reports) - ignored wholesale via the single-level `*`
# wildcard, then explicitly un-ignored per path for anything meant to be
# shared/tracked (settings.json, skills/). A bare `.claude/` (no `*`) instead
# of this would block the negations below entirely - git will not look inside
# an already-ignored directory to re-include a nested path. Adding something
# new under .claude/ that should be tracked (a command, an agent, etc.) needs
# its own `!.claude/<path>` line here, or it silently stays untracked.
.claude/*
!.claude/settings.json
!.claude/skills/
docs/private/
