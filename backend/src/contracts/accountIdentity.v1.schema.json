{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dugoutlineup.com/contracts/account-identity.v1.schema.json",
  "title": "GET /api/v1/account response (contract version 1)",
  "description": "Account and team-shell read model for Story #1130. Contains authenticated identity, active memberships, normalized roles/capabilities, and an optional untrusted pending-destination candidate. Roster, schedule, lineup, scoring, and other screen-owned data are deliberately excluded.",
  "x-budgets": {
    "maxServerLatencyMs": 300,
    "maxPayloadBytesForTenTeams": 25600,
    "maxDatabaseRoundTrips": 1
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "requestId", "identity", "memberships", "pendingDestination"],
  "properties": {
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "identity": { "$ref": "#/$defs/identity" },
    "memberships": {
      "type": "array",
      "items": { "$ref": "#/$defs/membership" },
      "description": "Every active membership visible to the authenticated caller. Inactive, invited, and revoked rows are excluded by the service implementation."
    },
    "pendingDestination": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/pendingDestination" }
      ],
      "description": "An untrusted resume candidate captured before authentication. Presence never grants access; the destination resolver must reauthorize it against this identity's current memberships before navigation."
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "email", "displayName", "firstName", "lastName"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "minLength": 1 },
        "firstName": { "type": ["string", "null"] },
        "lastName": { "type": ["string", "null"] }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label"],
      "properties": {
        "code": { "type": "string", "enum": ["admin", "coach", "scorekeeper", "viewer"] },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "type": "string",
      "enum": [
        "team.view", "team.manage",
        "membership.manage",
        "roster.view", "roster.manage",
        "schedule.view", "schedule.manage",
        "lineup.view", "lineup.create", "lineup.manage", "lineup.lock",
        "game.view_mode", "game.start_mode",
        "scoring.view", "scoring.claim", "scoring.record", "scoring.finalize"
      ]
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "displayName", "ageGroup", "season", "year", "sport"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "ageGroup": { "type": "string" },
        "season": { "type": "string", "enum": ["Spring", "Fall"] },
        "year": { "type": "integer", "minimum": 2000 },
        "sport": { "type": "string", "minLength": 1 }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "role", "capabilities"],
      "properties": {
        "team": { "$ref": "#/$defs/team" },
        "role": { "$ref": "#/$defs/role" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        }
      }
    },
    "pendingDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "savedAt"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/app(?:$|/|\\?)",
          "maxLength": 2048
        },
        "savedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
